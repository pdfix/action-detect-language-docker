{
    "template": {
        "object_update": [
            {
                "comment": "Select text page objects on the first page only",
                "query": {
                    "$and": [
                        {
                            "$page_num": "1"
                        }
                    ],
                    "param": [
                        "pds_text"
                    ]
                },
                "statement": "$if"
            }
        ]
    }
}
