                "25": "Failed to save PDF document.",
                "26": "Failed to set language to PDF document.",
                "27": "Failed to load template file.",
                "30": "No words were extracted from input.",
                "31": "No words were extracted from input."
            },
            "progress_regex": "^(?<text>[^:]+):\\s+(?<progress>\\d{1,3})%"
        },
