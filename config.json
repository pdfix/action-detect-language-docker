{
    "name": "Detect Language",
    "version": "v0.0.0",
    "actions": [
        {
            "title": "Set Document Language (LangDetect)",
            "name": "pdfix_detect_pdf_language_langdetect",
            "desc": "Automatically detects the language of a PDF and updates its metadata [Local]",
            "version": "v0.0.0",
            "icon": "language",
            "category": "Metadata",
            "local": true,
            "docker": {
                "name": "pdfix/detect-language",
                "tag": "latest"
            },
            "program": "docker run -v ${working_directory}:/data -w /data --rm pdfix/detect-language:latest set-document-language --name \"${license_name}\" --key \"${license_key}\" -i \"/data/${input_pdf}\" -o \"/data/${output_pdf}\" --maxwords \"${max_words}\"",
            "args": [
                {
                    "name": "input_pdf",
                    "desc": "Input PDF file",
                    "flags": 2,
                    "type": "file_path",
                    "ext": "pdf",
                    "value": ""
                },
                {
                    "name": "output_pdf",
                    "desc": "Output PDF file",
                    "flags": 4,
                    "type": "file_path",
                    "ext": "pdf",
                    "value": ""
                },
                {
                    "title": "Max Words",
                    "name": "max_words",
                    "desc": "How many words are considered for language detection",
                    "type": "int",
                    "value": "100"
                }
            ],
            "errors": {
                "10": "Failed to parse arguments. Please check the usage and try again.",
                "11": "Invalid regex or template. Please check the usage and try again.",
                "20": "Failed to initialize PDFix SDK.",
                "21": "Failed to activate PDFix SDK acount.",
                "22": "Failed to authorize PDFix SDK acount.",
                "23": "Failed to read PDF document.",
                "24": "Failed to open PDF document.",
                "25": "Failed to save PDF document.",
                "26": "Failed to set language to PDF document.",
                "30": "No words were extracted from input.",
                "31": "No words were extracted from input."
            },
            "progress_regex": "^(?<text>[^:]+):\\s+(?<progress>\\d{1,3})%"
        },
        {
            "title": "Set Tag Language (LangDetect)",
            "name": "pdfix_detect_tag_language_to_pdf_langdetect",
            "desc": "Automatically detects the language of each filtered tag text and saves the detected language to it in a PDF document [Local]",
            "version": "v0.0.0",
            "icon": "language",
            "category": "Metadata",
            "local": true,
            "docker": {
                "name": "pdfix/detect-language",
                "tag": "latest"
            },
            "program": "docker run -v ${working_directory}:/data -w /data --rm pdfix/detect-language:latest set-tag-language --name \"${license_name}\" --key \"${license_key}\" -i \"/data/${input_pdf}\" -o \"/data/${output_pdf}\" --maxwords \"${max_words}\" --overwrite \"${overwrite}\" --default-language \"${default_language}\"",
            "args": [
                {
                    "name": "input_pdf",
                    "desc": "Input PDF file",
                    "flags": 2,
                    "type": "file_path",
                    "ext": "pdf",
