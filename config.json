                    "desc": "Overwrite already existing language",
                    "type": "bool",
                    "value": false
                },
                {
                    "title": "Default Language",
                    "name": "default_language",
                    "desc": "Language applied when detection fails (e.g. numbers only)",
                    "type": "string",
                    "value": "en"
                }
            ],
            "params": [
                {
                    "title": "Tags",
                    "desc": "Specify the tags using a ECMAScript regular expression or define them by template tag_update",
                    "name": "tag_names",
                    "type": "tag",
                    "value": ".*",
                    "values": [
                        {
                            "desc": "All tags",
